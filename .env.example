# Copy this file to backend\.env and replace the placeholder with your Aiven DATABASE_URL.
# Do NOT commit the real .env - it contains credentials.
# Format (Aiven): postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require
# Both run-auth.cmd and run-user.cmd load this file automatically.
DATABASE_URL=postgres://YOUR_USER:YOUR_PASSWORD@YOUR_HOST.aivencloud.com:13351/YOUR_DB?sslmode=require